<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CadBatch</AssemblyName>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../packaging/icon/CadBatch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CadBatch.Updates/CadBatch.Updates.csproj" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <ProjectReference Include="../CadBatch.Core/CadBatch.Core.csproj" />
    <ProjectReference Include="../CadBatch.Transport/CadBatch.Transport.csproj" />
    <ProjectReference Include="../CadBatch.Pdf/CadBatch.Pdf.csproj" />
    <Compile Include="../CadBatch.SharedUi/*.cs" Link="UI/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../CadBatch.SharedUi/Assets/logo.png" LogicalName="CadBatch.Logo.png" />
  </ItemGroup>
</Project>
