<Project Sdk="Microsoft.NET.Sdk">
  <!-- Separate process for PDF work when the AutoCAD process has an incompatible PDF dependency loaded.
       .NET Framework 4.8 is present on every supported Windows, so one build serves all AutoCAD versions. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CadBatch.PdfWorker</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../CadBatch.Core/CadBatch.Core.csproj" />
    <ProjectReference Include="../CadBatch.Pdf/CadBatch.Pdf.csproj" />
  </ItemGroup>
</Project>
